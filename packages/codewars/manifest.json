{
  "schema_version": 2,
  "id": "com.kosmos.codewars",
  "name": "Codewars",
  "description": "Imports public Codewars profile and completed kata into ARK.",
  "version": "0.1.0",
  "kind": "source",
  "engine_api": ">=1.0.0",
  "entrypoint": "codewars-worker.exe",
  "icon": "icon.png",
  "publisher": "kosmos",
  "permissions": [
    {
      "capability": "network",
      "scopes": ["https://www.codewars.com/"]
    },
    {
      "capability": "ark.write",
      "scopes": ["upsert_object_type", "upsert_object", "set_sync_kv"]
    },
    {
      "capability": "ark.read",
      "scopes": ["list_objects", "get_sync_kv"]
    }
  ],
  "targets": [
    {
      "runtime": "worker",
      "os": ["windows"]
    }
  ],
  "data": {
    "access": [
      {
        "type": "coding_profile_obj",
        "versions": "*",
        "actions": ["read", "create", "update"],
        "fields": {
          "read": [],
          "write": []
        }
      },
      {
        "type": "coding_submission_obj",
        "versions": "*",
        "actions": ["create", "update"],
        "fields": {
          "read": [],
          "write": []
        }
      }
    ],
    "defines": [],
    "mappings": [
      {
        "type": "coding_profile_obj",
        "versions": "*",
        "direction": "import",
        "fidelity": "lossless"
      },
      {
        "type": "coding_submission_obj",
        "versions": "*",
        "direction": "import",
        "fidelity": "lossless"
      }
    ]
  },
  "integration": {
    "settings": [
      {
        "key": "username",
        "label": "Имя пользователя",
        "kind": "text",
        "description": "Публичное имя пользователя Codewars.",
        "required": true
      }
    ],
    "schedule": {
      "interval_seconds": 86400
    }
  }
}
