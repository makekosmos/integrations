{
  "schema_version": 2,
  "id": "com.kosmos.greatfrontend",
  "name": "GreatFrontEnd",
  "description": "Imports GreatFrontEnd progress into ARK.",
  "version": "0.1.0",
  "kind": "source",
  "engine_api": ">=1.0.0",
  "entrypoint": "greatfrontend-worker.exe",
  "icon": "icon.png",
  "publisher": "kosmos",
  "permissions": [
    {
      "capability": "network",
      "scopes": ["https://www.greatfrontend.com/"]
    },
    {
      "capability": "ark.write",
      "scopes": ["upsert_object_type", "upsert_object", "set_sync_kv"]
    },
    {
      "capability": "ark.read",
      "scopes": ["get_sync_kv"]
    }
  ],
  "targets": [
    {
      "runtime": "worker",
      "os": ["windows"]
    }
  ],
  "data": {
    "access": [
      {
        "type": "coding_submission_obj",
        "versions": "*",
        "actions": ["create", "update"],
        "fields": {
          "read": [],
          "write": []
        }
      }
    ],
    "defines": [],
    "mappings": [
      {
        "type": "coding_submission_obj",
        "versions": "*",
        "direction": "import",
        "fidelity": "lossless"
      }
    ]
  },
  "integration": {
    "settings": [
      {
        "key": "session",
        "label": "Сессия GreatFrontEnd",
        "kind": "secret",
        "description": "Секретная browser-сессия GreatFrontEnd.",
        "required": true,
        "injection": {
          "kind": "cookies",
          "origins": ["https://www.greatfrontend.com/"]
        }
      }
    ],
    "login": {
      "start_url": "https://www.greatfrontend.com/login",
      "completion_url": "https://www.greatfrontend.com/profile/progress",
      "allowed_cookie_names": ["supabase-auth-token"],
      "secret_setting": "session"
    },
    "schedule": {
      "interval_seconds": 86400
    }
  }
}
